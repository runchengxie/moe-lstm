---
import "../styles/global.css";
import Tx from "../components/Tx.astro";
import { copy, links, ui, type Localized } from "../i18n/copy";

interface Props {
  canonical?: boolean;
  canonicalUrl?: string;
  title?: Localized;
  description?: Localized;
}

const { canonical = false, title = copy.meta.title, description = copy.meta.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const onHome = path === base;
const onDocs = path.startsWith(`${base}docs/`);
---

<!doctype html>
<html
  lang="en"
  data-theme="system"
  data-title-zh={title.zh}
  data-title-en={title.en}
  data-desc-zh={description.zh}
  data-desc-en={description.en}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description.en} />
    <meta name="theme-color" content="#f3efe6" />
    <title>{title.en}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {canonical ? <link rel="canonical" href={Astro.props.canonicalUrl || links.pages} /> : null}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var lang = localStorage.getItem("moe-lang");
          if (lang === "en" || lang === "zh") root.lang = lang;
          var theme = localStorage.getItem("moe-theme");
          if (theme === "light" || theme === "dark" || theme === "system") {
            root.setAttribute("data-theme", theme);
          }
        } catch (err) {
          /* localStorage can throw in private mode; the defaults still render. */
        }
        var active = root.lang === "en" ? "en" : "zh";
        var title = root.getAttribute("data-title-" + active);
        var desc = root.getAttribute("data-desc-" + active);
        if (title) document.title = title;
        var description = document.querySelector('meta[name="description"]');
        if (description && desc) description.setAttribute("content", desc);
        var choice = root.getAttribute("data-theme") || "system";
        var dark =
          choice === "dark" ||
          (choice !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        var themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute("content", dark ? "#121417" : "#f3efe6");
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content"><Tx text={ui.skip} /></a>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={base}>moe_lstm</a>
        <nav class="site-nav">
          <a href={base} aria-current={onHome ? "page" : undefined}><Tx text={ui.navHome} /></a>
          <a href={`${base}docs/`} aria-current={onDocs ? "page" : undefined}><Tx text={ui.navDocs} /></a>
        </nav>
        <div class="control">
          <span class="caption" id="lang-label"><Tx text={ui.langLabel} /></span>
          <div class="seg" role="group" aria-labelledby="lang-label">
            <button type="button" data-set-lang="zh" aria-pressed="false"><Tx text={ui.langZh} /></button>
            <button type="button" data-set-lang="en" aria-pressed="true"><Tx text={ui.langEn} /></button>
          </div>
        </div>
        <div class="control">
          <span class="caption" id="theme-label"><Tx text={ui.themeLabel} /></span>
          <div class="seg" role="group" aria-labelledby="theme-label">
            <button type="button" data-set-theme="light" aria-pressed="false"><Tx text={ui.themeLight} /></button>
            <button type="button" data-set-theme="dark" aria-pressed="false"><Tx text={ui.themeDark} /></button>
            <button type="button" data-set-theme="system" aria-pressed="true"><Tx text={ui.themeSystem} /></button>
          </div>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-inner">
        <p><Tx text={ui.footer} /></p>
        <p>
          <a href={links.repo}>runchengxie/moe-lstm</a>
          {" · "}
          <a href={`${base}changelog/`}><Tx text={ui.navChangelog} /></a>
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/prefs.ts";
    </script>
  </body>
</html>
