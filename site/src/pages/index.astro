---
import Base from "../layouts/Base.astro";
import Tx from "../components/Tx.astro";
import { architecture, copy, L, links, showcase } from "../i18n/copy";

const base = import.meta.env.BASE_URL;
const trainLink = L("训练和回测", "Training and backtest");
const docsLink = L("文档", "Docs");
---

<Base canonical>
  <div class="wrap">
    <header class="hero">
      <p class="kicker"><Tx text={copy.hero.kicker} /></p>
      <h1><Tx text={copy.hero.title} /></h1>
      <p class="lede"><Tx text={copy.hero.lede} /></p>
      <ul class="notices">
        {
          copy.hero.notices.map((notice) => (
            <li class={notice.tone}>
              <Tx text={notice.text} />
            </li>
          ))
        }
      </ul>
      <p class="asof"><Tx text={copy.hero.asOf} /></p>
    </header>

    <section class="block" id="results" aria-labelledby="results-heading">
      <p class="sec-index">01</p>
      <div>
        <p class="kicker"><Tx text={showcase.kicker} /></p>
        <h2 id="results-heading"><Tx text={showcase.heading} /></h2>
        <p class="intro"><Tx text={showcase.empty} /></p>
        <p>
          <a href={links.engine}>quant-backtest-engine</a>
        </p>

        <figure class="chart-slot">
          <figcaption><Tx text={showcase.chartTitle} /></figcaption>
          <div class="chart-frame" data-chart="equity" data-value="run">
            <img
              src={`${base}results/equity-card.png`}
              width="1568"
              height="756"
              alt="Equity. Manual, KMeans, and SOM stay at 1. Buy and hold is the dashed line."
            />
          </div>
          <p class="note"><Tx text={showcase.chartNote} /></p>
        </figure>

        <figure class="chart-slot">
          <figcaption><Tx text={showcase.confusionTitle} /></figcaption>
          <div class="chart-frame" data-chart="confusion" data-value="run">
            <img
              src={`${base}results/confusion.png`}
              width="2063"
              height="544"
              alt="Confusion matrices for Manual, KMeans, and SOM. Predicted Above is 0."
            />
          </div>
          <p class="note"><Tx text={showcase.confusionNote} /></p>
        </figure>

        <ul class="metric-grid">
          {
            showcase.models.map((model) => (
              <li class="metric-card">
                <h3>{model.name}</h3>
                <dl>
                  {showcase.columns
                    .filter((column) =>
                      ["total-return", "max-drawdown", "sharpe"].includes(column.key),
                    )
                    .map((column) => (
                      <div>
                        <dt>{column.label}</dt>
                        <dd
                          data-model={model.id}
                          data-metric={column.key}
                          data-value={model.values[column.key] === "—" ? "na" : "run"}
                        >
                          {model.values[column.key]}
                        </dd>
                      </div>
                    ))}
                </dl>
              </li>
            ))
          }
        </ul>

        <div class="table-wrap">
          <table>
            <caption><Tx text={showcase.tableCaption} /></caption>
            <thead>
              <tr>
                <th scope="col"><Tx text={showcase.modelHeading} /></th>
                {showcase.columns.map((column) => <th scope="col">{column.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                showcase.models.map((model) => (
                  <tr>
                    <th scope="row">{model.name}</th>
                    {showcase.columns.map((column) => (
                      <td
                        data-model={model.id}
                        data-metric={column.key}
                        data-value={model.values[column.key] === "—" ? "na" : "run"}
                      >
                        {model.values[column.key]}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p><Tx text={showcase.runMeta} /></p>
        <p>
          <Tx text={showcase.filesLabel} />
          <a href={`${base}results/run.json`}>run.json</a>
          {" · "}
          <a href={`${base}results/metrics.txt`}>metrics.txt</a>
          {" · "}
          <a href={`${base}results/oos_probabilities.csv`}>oos_probabilities.csv</a>
          {" · "}
          <a href={`${base}results/equity.png`}>equity.png</a>
        </p>
        <p class="note">
          <Tx text={showcase.definitions} />
          {" "}
          <a href={`${base}docs/training/`}><Tx text={trainLink} /></a>
        </p>
      </div>
    </section>

    <section class="block" id="architecture" aria-labelledby="architecture-heading">
      <p class="sec-index">02</p>
      <div>
        <p class="kicker"><Tx text={architecture.kicker} /></p>
        <h2 id="architecture-heading"><Tx text={architecture.heading} /></h2>
        <p class="intro"><Tx text={architecture.lede} /></p>
        <ol class="arch">
          {
            copy.arch.map((item) => (
              <li>
                <span class="arch-n">{item.n}</span>
                <span class="arch-k"><Tx text={item.k} /></span>
                <span class="arch-v"><Tx text={item.v} /></span>
              </li>
            ))
          }
        </ol>
        <ol class="moe-flow" aria-label="sparse top-k">
          {
            architecture.flow.map((item) => (
              <li>
                <span class="arch-n">{item.n}</span>
                <span class="arch-k"><Tx text={item.k} /></span>
                <span class="arch-v"><Tx text={item.v} /></span>
              </li>
            ))
          }
        </ol>
        <p class="note"><Tx text={architecture.sparseNote} /></p>
        <h3><Tx text={architecture.dataHeading} /></h3>
        <p><Tx text={architecture.data} /></p>
        <h3><Tx text={architecture.splitHeading} /></h3>
        <p><Tx text={architecture.split} /></p>
        <p class="note">
          <Tx text={architecture.more} />
          {" "}
          <a href={`${base}docs/`}><Tx text={docsLink} /></a>
        </p>
      </div>
    </section>
  </div>
</Base>
