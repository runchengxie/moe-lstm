---
import Base from "../layouts/Base.astro";
import Tx from "../components/Tx.astro";
import { copy, ui } from "../i18n/copy";

const base = import.meta.env.BASE_URL;
---

<Base>
  <div class="wrap hero">
    <p class="kicker">404</p>
    <h1><Tx text={copy.missing.title} /></h1>
    <p class="lede"><Tx text={copy.missing.body} /></p>
    <p>
      <a href={base}><Tx text={copy.missing.home} /></a>
      {" · "}
      <a href={`${base}docs/`}><Tx text={ui.navDocs} /></a>
    </p>
  </div>
</Base>
